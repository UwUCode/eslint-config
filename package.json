{
  "name": "@uwu-codes/eslint-config",
  "version": "2.1.0",
  "description": "My eslint config for my projects.",
  "packageManager": "bun@1.3.10",
  "module": "dist/eslint.config.mjs",
  "types": "dist/eslint.config.d.ts",
  "exports": {
    ".": {
      "import": "./dist/eslint.config.mjs"
    },
    "./bun": {
      "import": "./dist/bun.config.mjs"
    },
    "./node": {
      "import": "./dist/node.config.mjs"
    }
  },
  "scripts": {
    "prepare": "bun run build",
    "build": "bun build eslint.config.mts --target=node --format=esm --outfile=dist/eslint.config.mjs --packages external && bun build bun.config.mts --target=node --format=esm --outfile=dist/bun.config.mjs --packages external && bun build node.config.mts --target=node --format=esm --outfile=dist/node.config.mjs --packages external && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "./release.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UwUCode/eslint-config.git"
  },
  "author": "Donovan_DMC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UwUCode/eslint-config/issues"
  },
  "homepage": "https://github.com/UwUCode/eslint-config#readme",
  "engines": {
    "bun": ">=1.3",
    "node": ">=22.13"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.74.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "jiti": "^2.6.1",
    "type-fest": "^6.0.3",
    "typescript": "^5.9.3"
  }
}
